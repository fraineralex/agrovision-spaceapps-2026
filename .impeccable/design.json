  "components": [
    {
      "name": "Acción principal de Siembra",
      "kind": "button",
      "refersTo": "planting-primary-sun",
      "description": "Colores semánticos vivos: el tema oscuro usa su acción histórica.",
      "html": "<button class=\"ds-primary\" type=\"button\">Guardar plan</button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;gap:8px;min-height:46px;padding:10px 16px;border:1px solid var(--primary);border-radius:10px;background:var(--primary);color:var(--primary-foreground);font-size:.95rem;font-weight:700;font-family:var(--font-sans,\"IBM Plex Sans\",ui-sans-serif,system-ui,sans-serif);}.ds-primary:hover{background:var(--primary);}.ds-primary:disabled{opacity:.55;cursor:not-allowed;}.ds-primary:focus-visible,.ds-secondary:focus-visible,.ds-select:focus-visible,.ds-nav button:focus-visible{outline:2px solid var(--focus);outline-offset:3px;}"
    },
    {
      "name": "Acción de fuentes",
      "kind": "button",
      "description": "Acceso secundario a explicación y fuentes.",
      "html": "<button class=\"ds-secondary\" type=\"button\">Ver fuentes</button>",
      "css": ".ds-secondary{display:inline-flex;align-items:center;gap:8px;min-height:46px;padding:10px 16px;border:1px solid var(--input);border-radius:10px;background:var(--card);color:var(--foreground);font-size:.9rem;font-weight:700;font-family:var(--font-sans,\"IBM Plex Sans\",ui-sans-serif,system-ui,sans-serif);}.ds-secondary:hover{background:var(--muted-surface);}.ds-primary:focus-visible,.ds-secondary:focus-visible,.ds-select:focus-visible,.ds-nav button:focus-visible{outline:2px solid var(--focus);outline-offset:3px;}"
    },
    {
      "name": "Selector de Siembra",
      "kind": "input",
      "description": "Muestra visual del disparador CustomSelect; el comportamiento real vive en React.",
      "html": "<button class=\"ds-select\" type=\"button\" aria-haspopup=\"listbox\" aria-expanded=\"false\"><span>Selecciona un mes</span><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"/></svg></button>",
      "css": ".ds-select{display:flex;align-items:center;justify-content:space-between;gap:10px;width:100%;min-height:46px;padding:8px 12px;border:1.5px solid var(--border);border-radius:10px;background:var(--card);color:var(--foreground);font-size:15px;font-weight:700;text-align:left;transition:border-color 140ms ease,box-shadow 140ms ease,background 140ms ease;font-family:var(--font-sans,\"IBM Plex Sans\",ui-sans-serif,system-ui,sans-serif);}.ds-select:hover{background:var(--elevated);border-color:var(--focus);}.ds-select svg{color:var(--success);flex-shrink:0;}.ds-primary:focus-visible,.ds-secondary:focus-visible,.ds-select:focus-visible,.ds-nav button:focus-visible{outline:2px solid var(--focus);outline-offset:3px;}"
    },
    {
      "name": "Navegación",
      "kind": "nav",
      "description": "Cinco pestañas compartidas; selección aria-selected y navegación inferior hasta 760px.",
      "html": "<nav class=\"ds-nav\" role=\"tablist\" aria-label=\"Secciones\"><button type=\"button\" role=\"tab\" aria-selected=\"true\">Siembra</button><button type=\"button\" role=\"tab\" aria-selected=\"false\">Lluvia</button><button type=\"button\" role=\"tab\" aria-selected=\"false\">Venta</button><button type=\"button\" role=\"tab\" aria-selected=\"false\">Fincas</button><button type=\"button\" role=\"tab\" aria-selected=\"false\">Ayuda</button></nav>",
      "css": ".ds-nav{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:4px;margin:0;padding:4px;border:1px solid var(--border);border-radius:12px;background:var(--card);box-shadow:none;}.ds-nav button{display:flex;align-items:center;justify-content:center;gap:8px;min-width:0;min-height:44px;padding:8px 12px;border:0;border-radius:9px;background:transparent;color:var(--muted);font-size:.95rem;font-weight:650;font-family:var(--font-sans,\"IBM Plex Sans\",ui-sans-serif,system-ui,sans-serif);}.ds-nav button[aria-selected=true]{background:var(--primary);color:var(--primary-foreground);box-shadow:none;}.ds-nav button:not([aria-selected=true]):hover{background:var(--elevated);}.ds-nav button:focus-visible{outline:2px solid var(--focus);outline-offset:3px;}@media(max-width:760px){.ds-nav button{flex-direction:column;gap:3px;min-height:50px;padding:4px 2px;font-size:.75rem;}}"
    },
    {
      "name": "Estado con etiqueta",
      "kind": "chip",
      "description": "El estado se expresa con una palabra además del color; muestra sin datos.",
      "html": "<span class=\"ds-state\">Sin datos</span>",
      "css": ".ds-state{display:inline-flex;padding:4px 8px;border:1px solid var(--status-gray-border);border-radius:999px;background:var(--status-gray-bg);color:var(--status-gray-fg);font-size:.75rem;font-family:var(--font-sans,\"IBM Plex Sans\",ui-sans-serif,system-ui,sans-serif);}"
    },
    {
      "name": "PlantingPanel",
      "kind": "card",
      "refersTo": "planting-panel-sun",
      "description": "SectionPanel reutilizado por Siembra, con encabezado y radio propios. Icono Leaf de Lucide (ISC), recurso existente.",
      "html": "<section class=\"ds-panel\"><h2><svg width=\"21\" height=\"21\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"ds-panel-icon\" aria-hidden=\"true\"><path d=\"M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z\"></path><path d=\"M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12\"></path></svg>Rotación y suelo</h2><p>Revisa las fuentes y los límites de cada opción.</p></section>",
      "css": ".ds-panel{padding:20px;border:1px solid var(--border);border-radius:16px;background:var(--card);color:var(--foreground);box-shadow:none;font-family:var(--font-sans,\"IBM Plex Sans\",ui-sans-serif,system-ui,sans-serif);}.ds-panel h2{display:flex;align-items:center;gap:10px;margin:0;padding-bottom:20px;font-family:var(--font-display,\"Bricolage Grotesque\",sans-serif);font-size:1.3rem;font-weight:750;line-height:1.35;letter-spacing:-.02em;}.ds-panel h2 svg{color:var(--success);flex-shrink:0;}.ds-panel p{margin:0;max-width:75ch;font-size:1rem;line-height:1.6;color:var(--muted);}@media(max-width:800px){.ds-panel{padding:20px;}}@media(max-width:600px){.ds-panel{padding:16px;}.ds-panel h2{font-size:1.2rem;padding-bottom:16px;}}"
    },
    {
      "name": "SectionPanel",
      "kind": "card",
      "refersTo": "section-panel-sun",
      "description": "Panel compartido por las áreas de trabajo; Fold y PlantingPanel reutilizan esta estructura. Icono Leaf de Lucide (ISC).",
      "html": "<section class=\"ds-section-panel\"><h2><svg width=\"21\" height=\"21\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"ds-section-panel-icon\" aria-hidden=\"true\"><path d=\"M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z\"></path><path d=\"M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12\"></path></svg>Rotación y suelo</h2><p>Revisa las fuentes y los límites de cada opción.</p></section>",
      "css": ".ds-section-panel{padding:20px;border:1px solid var(--border);border-radius:16px;background:var(--card);color:var(--foreground);box-shadow:none;font-family:var(--font-sans,\"IBM Plex Sans\",ui-sans-serif,system-ui,sans-serif);}.ds-section-panel h2{display:flex;align-items:center;gap:10px;margin:0 0 16px;padding-bottom:0;font-family:var(--font-display,\"Bricolage Grotesque\",sans-serif);font-size:1.3rem;font-weight:750;line-height:1.35;letter-spacing:-.02em;}.ds-section-panel h2 svg{color:var(--success);flex-shrink:0;}.ds-section-panel p{margin:0;max-width:75ch;font-size:1rem;line-height:1.6;color:var(--muted);}@media(max-width:600px){.ds-section-panel{padding:16px;border-radius:12px;}.ds-section-panel h2{font-size:1.2rem;margin-bottom:14px;}}"
    }
  ],
  "narrative": {
    "northStar": "Campo y evidencia",
    "overview": "AgroVision conserva su identidad agrícola: verde bosque en marca y navegación, cultivos ilustrados con FarmIcon, estrellas comparativas y datos con sus fuentes. La jerarquía permite leer la recomendación, comparar señales y abrir evidencia sin convertir la interfaz en una promesa agronómica.\n\nEsta guía sustituye los criterios visuales contradictorios de auditorías y notas anteriores. Alcance ampliado explícitamente por Frainer en esta conversación el 15-11-2026: mejorar UI y UX de toda la aplicación y eliminar espacios vacíos llamativos conservando identidad, contenido y funciones. La dirección oficial de producto, evidencia, autoría y privacidad de AGENTS.md sigue vigente. El piloto es el Valle de San Juan. No se cambia el motor de datos por una decisión visual.",
    "keyCharacteristics": [
      "Dos temas: superficies blancas en modo sol y verde negro histórico en oscuro.",
      "IBM Plex Sans para lectura; Bricolage Grotesque para títulos y cifras destacadas.",
      "Iconos existentes, estados con palabras y color, fuentes a mano.",
      "Paneles compartidos, densidad legible y jerarquía estable en las cinco pestañas, fuentes y onboarding."
    ],
    "rules": [
      {
        "name": "The Shared Palette Rule",
        "body": "Ningún componente define su propia paleta. La recomendación usa la misma superficie que las otras tarjetas y se identifica con texto; no se introduce otra variante marfil del modo sol.",
        "section": "colors"
      },
      {
        "name": "The Readable Evidence Rule",
        "body": "Mantener nombres y estados completos, numerales tabulares en métricas y contraste de texto secundario en ambos temas. La UI usa español dominicano; nombres científicos y nombres oficiales de fuentes se preservan.",
        "section": "typography"
      },
      {
        "name": "The Flat Workspace Rule",
        "body": "En paneles compartidos, no acumular sombra, halo y borde; la jerarquía se construye con espacio, texto y divisores. La transición de controles es breve y respeta reducción de movimiento.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** reutilizar componentes, iconos, tipografías, gráficos y fuentes existentes.",
      "**Do** expresar estados con palabras además de color, incluido «Sin datos».",
      "**Do** conservar foco visible, lectura completa y acceso a evidencia en ambos temas.",
      "**Do** mantener fuente, período, unidad, escala espacial y confianza/calidad de cada métrica, distinguiendo observación, reanálisis, regla y dato declarado."
    ],
    "donts": [
      "**Don't** añadir una paleta local, otra familia tipográfica o una variante marfil del modo sol.",
      "**Don't** ocultar cultivos para simplificar la comparación ni añadir pasos o datos decorativos.",
      "**Don't** convertir señales regionales en mediciones de finca o presentar predicciones de rendimiento, plagas o rentabilidad garantizada.",
      "**Don't** cambiar cálculos, fuentes, privacidad ni dirección oficial de producto por una decisión visual."
    ]
  }
}
